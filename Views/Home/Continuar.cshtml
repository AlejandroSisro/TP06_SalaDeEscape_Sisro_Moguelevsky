@{
    ViewData["Title"] = "Continuar";
}

<div class="page-shell">
    <div class="status-panel text-center">
        <p class="eyebrow">Partida guardada</p>
        <h1>Continuar</h1>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form method="post" asp-action="Continuar" class="login-container" style="min-height:auto; padding:1.5rem 0 0.5rem; display:block;">
            <div style="max-width:420px; margin:0 auto;">
                <input type="text" name="usuario" placeholder="Ingresá tu nombre de usuario" value="" required style="width:100%; margin-bottom:1rem;" />
                <button type="submit" class="btn btn-primary" style="width:100%;">Buscar partida</button>
            </div>
        </form>

        <div style="margin-top:1rem;">
            <a class="btn-primary" href="/Home/Index">Volver al inicio</a>
        </div>
    </div>
</div>
