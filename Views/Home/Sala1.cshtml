@{
    ViewData["Title"] = "Encuentro divino - Juicio de los Dioses";
}

<div class="page-shell sala1-shell">
    <div class="status-panel sala1-panel">
        <p class="eyebrow">Sala 1</p>
        <h1>Encuentro divino - Juicio de los Dioses</h1>
        <p class="lead">Elegí a tu protector.</p>

        @if (ViewBag.Dios1 != null && ViewBag.Dios2 != null && (ViewBag.ShowRiddle == null || ViewBag.ShowRiddle == false) && ViewBag.AnswerCorrect == null)
        {
            <form method="post" asp-action="Sala1" class="dios-selection-form">
                <input type="hidden" name="dios1Id" value="@ViewBag.Dios1.IdDios" />
                <input type="hidden" name="dios2Id" value="@ViewBag.Dios2.IdDios" />
                <div class="dios-list">
                    <div class="dios-card">
                        <img class="dios-img" src="/Imagenes/Personajes/@ViewBag.Dios1.FotoDios" alt="@ViewBag.Dios1.Nombre" />
                        <h3>@ViewBag.Dios1.Nombre</h3>
                        <p>@ViewBag.Dios1.Dialogo</p>
                        <div class="dios-choice-row">
                            <label class="dios-choice-label">
                                <input type="radio" name="elegidoId" value="@ViewBag.Dios1.IdDios" />
                                <span>Elegir a @ViewBag.Dios1.Nombre</span>
                            </label>
                        </div>
                    </div>

                    <div class="dios-card">
                        <img class="dios-img" src="/Imagenes/Personajes/@ViewBag.Dios2.FotoDios" alt="@ViewBag.Dios2.Nombre" />
                        <h3>@ViewBag.Dios2.Nombre</h3>
                        <p>@ViewBag.Dios2.Dialogo</p>
                        <div class="dios-choice-row">
                            <label class="dios-choice-label">
                                <input type="radio" name="elegidoId" value="@ViewBag.Dios2.IdDios" />
                                <span>Elegir a @ViewBag.Dios2.Nombre</span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Confirmar elección</button>
                </div>
            </form>
        }

        @if (ViewBag.ShowRiddle == true && ViewBag.Elegido != null && ViewBag.Otro != null)
        {
            <div class="riddle-panel">
                <div class="riddle-figure">
                    <div class="riddle-card">
                        <img class="dios-img" src="/Imagenes/Personajes/@ViewBag.Elegido.FotoDios" alt="@ViewBag.Elegido.Nombre" />
                        <h3>Has elegido a @ViewBag.Elegido.Nombre</h3>
                        <p>@ViewBag.Elegido.Dialogo</p>
                    </div>

                    <div class="riddle-card">
                        <img class="dios-img" src="/Imagenes/Personajes/@ViewBag.Otro.FotoDios" alt="@ViewBag.Otro.Nombre" />
                        <h4>@ViewBag.Otro.Nombre te propone un acertijo:</h4>
                        <p class="riddle-question">¿Qué ser camina a cuatro patas por la mañana, a dos al mediodía y a tres por la noche?</p>

                        <form method="post" asp-action="ResponderEsfinge" class="riddle-form">
                            <input type="hidden" name="elegidoId" value="@ViewBag.Elegido.IdDios" />
                            <input type="hidden" name="dios1Id" value="@ViewBag.Dios1.IdDios" />
                            <input type="hidden" name="dios2Id" value="@ViewBag.Dios2.IdDios" />
                            <div class="form-group">
                                <label for="respuesta">Respuesta:</label>
                                <input type="text" name="respuesta" id="respuesta" class="form-control" placeholder="Escribí tu respuesta..." />
                            </div>
                            <div class="form-actions">
                                <button type="submit" class="btn btn-primary">Enviar respuesta</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }

        @if (ViewBag.AnswerCorrect != null)
        {
            if ((bool)ViewBag.AnswerCorrect)
            {
                <div class="answer-alert success">¡Correcto! Has resuelto el acertijo.</div>
            }
            else
            {
                <div class="answer-alert error">Respuesta incorrecta. Intenta de nuevo.</div>
                <form method="post" asp-action="ResponderEsfinge" class="riddle-form retry-form">
                    <input type="hidden" name="elegidoId" value="@ViewBag.Elegido.IdDios" />
                    <input type="hidden" name="dios1Id" value="@ViewBag.Dios1.IdDios" />
                    <input type="hidden" name="dios2Id" value="@ViewBag.Dios2.IdDios" />
                    <div class="form-group">
                        <label for="respuesta2">Respuesta:</label>
                        <input type="text" name="respuesta" id="respuesta2" class="form-control" placeholder="Reintenta tu respuesta..." />
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">Reintentar</button>
                    </div>
                </form>
            }
        }
    </div>
</div>
